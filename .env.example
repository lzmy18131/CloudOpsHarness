# ============================================================
# AegisOps environment template. Copy to .env (never commit .env)
# ============================================================

# --- LLM (OpenAI-compatible: DeepSeek / OpenAI / Qwen / vLLM ...) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# If LLM_API_KEY is empty the server boots in offline mode and uses FakeLLM.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Runtime ---
AEGIS_ENVIRONMENT=dev
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8090
AEGIS_LOG_LEVEL=INFO

# --- Storage ---
# checkpoint: sqlite (default, survives restart) | memory
AEGIS_CHECKPOINT_BACKEND=sqlite
# storage: file (default, zero dependency) | mongo
AEGIS_STORAGE_BACKEND=file
# AEGIS_MONGO_URI=mongodb://localhost:27017

# --- Sandbox ---
# auto: use Docker when available, otherwise Local fallback (dev only)
# docker: require DockerSandboxBackend (production recommended)
# local: LocalSandboxBackend (NOT a security boundary, dev/demo only)
AEGIS_SANDBOX_BACKEND=auto
AEGIS_SANDBOX_IMAGE=python:3.11-slim
AEGIS_SANDBOX_EXEC_TIMEOUT_SECONDS=30
AEGIS_SANDBOX_PREWARM=false
AEGIS_SANDBOX_AUTO_RECOVERY=true

# --- Harness limits ---
AEGIS_MODEL_CALL_LIMIT=60
AEGIS_TOOL_CALL_LIMIT=120
AEGIS_MAX_PLAN_STEPS=20
AEGIS_MAX_DELEGATION_DEPTH=2
AEGIS_CONTEXT_COMPRESSION_THRESHOLD_TOKENS=24000
# Context isolation off only for evaluation ablations.
AEGIS_CONTEXT_ISOLATION=true
# Risk levels that run WITHOUT human approval: 0=read-only, 1=low-risk write
AEGIS_AUTO_APPROVE_MAX_RISK=1

# --- MCP ---
AEGIS_MCP_TRANSPORT=inprocess

# --- CORS ---
AEGIS_ALLOWED_ORIGINS=*
