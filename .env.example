# ============================================================
# CloudOps Harness environment template. Copy to .env (never commit .env)
# ============================================================

# --- LLM (OpenAI-compatible: DeepSeek / OpenAI / Qwen / vLLM ...) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# If LLM_API_KEY is empty the server boots in offline mode and uses FakeLLM.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=4096

# --- Runtime ---
CLOUDOPS_ENVIRONMENT=dev
CLOUDOPS_HOST=127.0.0.1
CLOUDOPS_PORT=8090
CLOUDOPS_LOG_LEVEL=INFO

# --- Storage ---
# checkpoint: sqlite (default, survives restart) | memory
CLOUDOPS_CHECKPOINT_BACKEND=sqlite
# storage: file (default, zero dependency) | mongo
CLOUDOPS_STORAGE_BACKEND=file
# CLOUDOPS_MONGO_URI=mongodb://localhost:27017

# --- Sandbox ---
# auto: use Docker when available, otherwise Local fallback (dev only)
# docker: require DockerSandboxBackend (production recommended)
# local: LocalSandboxBackend (NOT a security boundary, dev/demo only)
CLOUDOPS_SANDBOX_BACKEND=auto
CLOUDOPS_SANDBOX_IMAGE=python:3.11-slim
CLOUDOPS_SANDBOX_EXEC_TIMEOUT_SECONDS=30
CLOUDOPS_SANDBOX_PREWARM=false
CLOUDOPS_SANDBOX_AUTO_RECOVERY=true

# --- Harness limits ---
CLOUDOPS_MODEL_CALL_LIMIT=60
CLOUDOPS_TOOL_CALL_LIMIT=120
CLOUDOPS_MAX_PLAN_STEPS=20
CLOUDOPS_MAX_DELEGATION_DEPTH=2
CLOUDOPS_CONTEXT_COMPRESSION_THRESHOLD_TOKENS=24000
# Context isolation off only for evaluation ablations.
CLOUDOPS_CONTEXT_ISOLATION=true
# Risk levels that run WITHOUT human approval: 0=read-only, 1=low-risk write
CLOUDOPS_AUTO_APPROVE_MAX_RISK=1

# --- MCP ---
CLOUDOPS_MCP_TRANSPORT=inprocess

# --- CORS ---
CLOUDOPS_ALLOWED_ORIGINS=*
